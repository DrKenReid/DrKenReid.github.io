{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.kenreid.co.uk/data/schema/reading-analysis.schema.json",
  "title": "data/reading-analysis.json",
  "description": "A dated snapshot of the reading figures the weekly RSS feed can't give: how my ratings compare with each book's Goodreads average, genres, and the to-read and did-not-finish shelves. Written by scripts/site_summary.py in the GoodReads-Analysis repository from a Goodreads export enhanced with Enhance-GoodReads-Export; the literature page's Reading Stats shows it. Intervals are 95% percentile bootstraps.",
  "type": "object",
  "required": [
    "exported",
    "shelves",
    "rated",
    "fourOrFive",
    "community",
    "genres",
    "topGenre"
  ],
  "additionalProperties": false,
  "properties": {
    "exported": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "The date the Goodreads export was downloaded. Every figure is true as of then."
    },
    "shelves": {
      "type": "object",
      "required": [
        "read",
        "toRead",
        "didNotFinish"
      ],
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "integer",
          "minimum": 0
        },
        "toRead": {
          "type": "integer",
          "minimum": 0
        },
        "didNotFinish": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rated": {
      "type": "integer",
      "minimum": 0,
      "description": "Read books with a rating."
    },
    "fourOrFive": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "Share of rated books given four or five stars."
    },
    "community": {
      "type": [
        "object",
        "null"
      ],
      "description": "My rating against each book's Goodreads average; null without the enhanced average_rating column.",
      "required": [
        "books",
        "myMean",
        "crowdMean",
        "difference",
        "differenceLow",
        "differenceHigh",
        "rho",
        "rhoLow",
        "rhoHigh",
        "byStar"
      ],
      "additionalProperties": false,
      "properties": {
        "books": {
          "type": "integer",
          "minimum": 1
        },
        "myMean": {
          "type": "number",
          "description": "My mean rating over these books."
        },
        "crowdMean": {
          "type": "number",
          "description": "The mean Goodreads average over the same books."
        },
        "difference": {
          "type": "number",
          "description": "Mean of my rating minus the Goodreads average, in stars."
        },
        "differenceLow": {
          "type": "number"
        },
        "differenceHigh": {
          "type": "number"
        },
        "rho": {
          "type": "number",
          "description": "Spearman's rank correlation between my rating and the average."
        },
        "rhoLow": {
          "type": "number"
        },
        "rhoHigh": {
          "type": "number"
        },
        "byStar": {
          "type": "array",
          "description": "The mean Goodreads average of the books I gave each star, with its interval.",
          "items": {
            "type": "object",
            "required": [
              "stars",
              "books",
              "mean",
              "low",
              "high"
            ],
            "additionalProperties": false,
            "properties": {
              "stars": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "books": {
                "type": "integer",
                "minimum": 1
              },
              "mean": {
                "type": "number"
              },
              "low": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "high": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "genres": {
      "type": "array",
      "description": "My mean rating by each book's top genre, for genres with enough books to say anything, highest first.",
      "items": {
        "type": "object",
        "required": [
          "genre",
          "books",
          "mean",
          "low",
          "high"
        ],
        "additionalProperties": false,
        "properties": {
          "genre": {
            "type": "string"
          },
          "books": {
            "type": "integer",
            "minimum": 1
          },
          "mean": {
            "type": "number"
          },
          "low": {
            "type": [
              "number",
              "null"
            ]
          },
          "high": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "topGenre": {
      "type": [
        "object",
        "null"
      ],
      "description": "The genre on the most of my read books; null without the enhanced genres column.",
      "required": [
        "genre",
        "books"
      ],
      "additionalProperties": false,
      "properties": {
        "genre": {
          "type": "string"
        },
        "books": {
          "type": "integer",
          "minimum": 1
        },
        "mean": {
          "type": "number",
          "description": "My mean rating for that genre, when it has enough books to have an interval in genres."
        }
      }
    }
  }
}
